# Cloudflare Pages reads this file at deploy time.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# HTML must revalidate, or a deploy does not reach anyone still holding the
# old page. This is the file that changed when you edited copy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Stylesheet and script share filenames across deploys, so they get a short
# life rather than an immutable one.
/assets/css/*
  Cache-Control: public, max-age=3600

/assets/js/*
  Cache-Control: public, max-age=3600

# Images and clips are named by content and width and effectively never change
# in place; a week is safe and keeps repeat visits instant.
/assets/img/*
  Cache-Control: public, max-age=604800

/assets/video/*
  Cache-Control: public, max-age=604800

/assets/cv/*
  Cache-Control: public, max-age=86400
